{{- $searchIndex := slice -}}
{{- $currentSection := .Section -}}

{{- range where .Pages "IsPage" true -}}
  {{- if eq $currentSection "people" -}}
    {{- $countryVal := "" -}}
    {{- with .Params.country -}}
      {{- if reflect.IsSlice . -}}
        {{- $countryVal = delimit . " " -}}
      {{- else -}}
        {{- $countryVal = . -}}
      {{- end -}}
    {{- end -}}

    {{- $item := dict 
      "url" .Permalink 
      "name" .Title 
      "altname" (default "" .Params.altname)
      "description" (default "" .Params.description)
      "birth" (cond (ne .Params.birth nil) (int .Params.birth) "")
      "death" (cond (ne .Params.death nil) (int .Params.death) "")
      "locations" (default "" .Params.locations)
      "gender" (default "" .Params.gender)
      "country" $countryVal
    -}}
    {{- $searchIndex = $searchIndex | append $item -}}

  {{- else if eq $currentSection "pseudonyms" -}}
    {{/* Safely handle .Params.people as a slice or map */}}
    {{- $activeVal := "" -}}
    {{- with .Params.people -}}
      {{- if reflect.IsSlice . -}}
        {{/* If people is a list, collect all active values or inspect the first item */}}
        {{- $actives := slice -}}
        {{- range . -}}
          {{- with .active -}}
            {{- $actives = $actives | append (string .) -}}
          {{- end -}}
        {{- end -}}
        {{- $activeVal = delimit $actives " " -}}
      {{- else if reflect.IsMap . -}}
        {{/* If people is a single map */}}
        {{- with .active -}}
          {{- $activeVal = string . -}}
        {{- end -}}
      {{- end -}}
    {{- end -}}

    {{- $item := dict 
      "url" .Permalink 
      "name" .Title 
      "active" $activeVal
    -}}
    {{- $searchIndex = $searchIndex | append $item -}}

  {{- else if eq $currentSection "articles" -}}
    {{- $item := dict 
      "url" .Permalink 
      "name" .Title 
    -}}
    {{- $searchIndex = $searchIndex | append $item -}}
  {{- end -}}
{{- end -}}

{{- $searchIndex | jsonify (dict "indent" "  ") -}}