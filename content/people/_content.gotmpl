{{/* Fetch the JSON resource */}}
{{ $data := dict }}
{{ $path := "joined_data.json" }}
{{ with resources.Get $path }}
  {{ with . | transform.Unmarshal }}
    {{ $data = . }}
  {{ end }}
{{ else }}
  {{ errorf "Unable to get local resource %q" $path }}
{{ end }}

{{ range $data }}

  {{ $name := index . "name in standard form" }}
  {{ $altname := index . "alternative name" }}
  {{ $description := index . "short description" }}
  {{ $circa := index . "± birth year" }}
  {{ $birth := index . "birth year" }}
  {{ $death := index . "death year" }}
  {{ $authorId := .authorId }}

  {{ $signatures := slice }}
  {{ $articlesByPseudonym := dict }}

  {{ range .articles }}
    {{ $art := . }}

    {{/* Clean whitespace from Title */}}
    {{ $cleanTitle := trim $art.title " \t\n\r" }}

    {{/* Construct NQ citation string: NQ [series].[volume].[page] */}}
    {{ $citeParts := slice }}
    {{ with $art.series }}{{ $citeParts = $citeParts | append . }}{{ end }}
    {{ with $art.volume }}{{ $citeParts = $citeParts | append . }}{{ end }}
    {{ with $art.page }}{{ $citeParts = $citeParts | append . }}{{ end }}

    {{ $nqCitation := "" }}
    {{ if $citeParts }}
      {{ $nqCitation = printf "NQ %s" (delimit $citeParts ".") }}
    {{ end }}

    {{/* Clean whitespace from Signature while preserving original casing */}}
    {{ $cleanSig := trim $art.signature " \t\n\r" }}
    {{ $signatures = $signatures | append $cleanSig }}

    {{/* Map key (normalized for lookup) */}}
    {{ $groupKey := lower $cleanSig }}

    {{/* Create structured article object */}}
    {{ $articleObj := dict
      "title" $cleanTitle
      "citation" $nqCitation
      "url" $art.url
    }}

    {{/* Group articles under their pseudonym key while explicitly tracking original display signature */}}
    {{ $existingGroup := index $articlesByPseudonym $groupKey }}
    {{ $articlesList := slice }}
    {{ if $existingGroup }}
      {{ $articlesList = index $existingGroup "articles" }}
    {{ end }}

    {{ $articlesList = $articlesList | append $articleObj }}

    {{ $groupData := dict
      "displaySignature" $cleanSig
      "articles" $articlesList
    }}

    {{ $articlesByPseudonym = merge $articlesByPseudonym (dict $groupKey $groupData) }}
  {{ end }}

  {{/* Glossary letter for people listing */}}
  {{ $glossary := upper (substr $name 0 1) }}

  {{ $params := dict 
    "notes" .notes
    "biography" .biography
    "gender" .gender
    "articlesByPseudonym" $articlesByPseudonym
    "signatures" ($signatures | uniq)
    "altname" $altname
    "description" $description
    "circa" $circa
    "birth" $birth
    "death" $death
    "authorId" $authorId
    "glossary" $glossary
  }}

  {{ $page := dict
    "params" $params 
    "content" (dict "mediaType" "text/html")
    "path" $authorId
    "title" $name
    "kind" "page"
    "draft" false
  }}

  {{ $.AddPage $page }}

{{ end }}