{{/* Fetch the JSON resource */}}
{{ $data := dict }}
{{ $path := "joined_data.json" }}
{{ with resources.Get $path }}
  {{ with . | transform.Unmarshal }}
    {{ $data = . }}
  {{ end }}
{{ else }}
  {{ errorf "Unable to get local resource %q" $path }}
{{ end }}

{{ range $data }}

  {{ $name := index . "name in standard form" }}
  {{ $altname := index . "alternative name" }}
  {{ $description := index . "short description" }}
  {{ $circa := index . "± birth year" }}
  {{ $birth := index . "birth year" }}
  {{ $death := index . "death year" }}
  {{ $authorId := .authorId }}

  {{ $articles := slice }}
  {{ $signatures := slice }}

  {{ range .articles }}
    {{ $art := . }}

    {{/* Clean whitespace from Title */}}
    {{ $cleanTitle := trim $art.title " \t\n\r" }}

    {{/* Construct NQ citation string: NQ [series].[volume].[page] */}}
    {{ $citeParts := slice }}
    {{ with $art.series }}{{ $citeParts = $citeParts | append . }}{{ end }}
    {{ with $art.volume }}{{ $citeParts = $citeParts | append . }}{{ end }}
    {{ with $art.page }}{{ $citeParts = $citeParts | append . }}{{ end }}

    {{ $nqCitation := "" }}
    {{ if $citeParts }}
      {{ $nqCitation = printf "NQ %s" (delimit $citeParts ".") }}
    {{ end }}

    {{/* Clean whitespace from Signature */}}
    {{ $cleanSig := "" }}
    {{ with $art.signature }}
      {{ $cleanSig = trim . " \t\n\r" }}
    {{ end }}

    {{/* Build Signature HTML Link if signature exists */}}
    {{ $sigLink := "" }}
    {{ if ne $cleanSig "" }}
      {{ $signatures = $signatures | append $cleanSig }}

      {{/* Safe path matching /content/signatures/_content.gotmpl logic */}}
      {{ $safePath := urlize $cleanSig }}
      {{ if eq $safePath "" }}
        {{ $safePath = anchorize $cleanSig }}
      {{ end }}

      {{ $sigUrl := printf "/nq-proto/pseudonyms/%s/" $safePath | relURL }}
      {{ $sigLink = printf "<a href=%q>%s</a>" $sigUrl $cleanSig }}
    {{ end }}

    {{/* Format Title */}}
    {{ $titleStr := printf "%s" $cleanTitle }}

    {{/* Combine Title and "writing as [Signature Link]" */}}
    {{ $entryMain := $titleStr }}
    {{ if ne $sigLink "" }}
      {{ $entryMain = printf "%s, writing as %s" $titleStr $sigLink }}
    {{ end }}

    {{/* Attach citation with dash if citation exists */}}
    {{ $articleEntry := $entryMain }}
    {{ if ne $nqCitation "" }}
      {{ $articleEntry = printf "%s — %s" $entryMain $nqCitation }}
    {{ end }}

    {{ $articles = $articles | append $articleEntry }}
  {{ end }}

  {{/* Glossary letter for people listing */}}
  {{ $glossary := upper (substr $name 0 1) }}

  {{ $params := dict 
    "notes" .notes
    "biography" .biography
    "gender" .gender
    "articles" $articles
    "signatures" ($signatures | uniq)
    "altname" $altname
    "description" $description
    "circa" $circa
    "birth" $birth
    "death" $death
    "authorId" $authorId
    "glossary" $glossary
  }}

  {{ $page := dict
    "params" $params 
    "content" (dict "mediaType" "text/html")
    "path" $authorId
    "title" $name
    "kind" "page"
    "draft" false
  }}

  {{ $.AddPage $page }}

{{ end }}